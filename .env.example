# Required: Anthropic API key for patient simulation and LLM-based evaluation
ANTHROPIC_API_KEY=sk-ant-...

# Required by Chainlit when password authentication is enabled.
# Generate one with: chainlit create-secret
CHAINLIT_AUTH_SECRET=replace_me_with_a_long_random_string

# Optional: URL of the RAG server. Defaults to http://localhost:8000.
# The app degrades gracefully when this is unreachable (a banner is shown).
SERVER_URL=http://localhost:8000
