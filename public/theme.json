{
  "_comment": "Maps DESIGN.md tokens to Chainlit's shadcn variables. Values are HSL space-separated (no hsl() wrapper). Hex equivalents in tokens.css. The Ollama-style design is paper-white only; we keep the dark block conservative for users who flip the theme.",
  "custom_fonts": [
    "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Nunito:wght@500;600;700&display=swap"
  ],
  "variables": {
